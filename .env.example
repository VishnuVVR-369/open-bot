# Copy to .env and adjust. Every value has a development default except OWNER_EMAIL.

# The only email that can sign in.
OWNER_EMAIL=you@example.com

DATABASE_URL=postgres://openbot:openbot@127.0.0.1:54329/openbot
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Shared between the web app and the worker.
WORKER_URL=http://127.0.0.1:4001
WORKER_SECRET=dev-worker-secret-change-me
# Where browsers and the desktop app reach the worker's websockets (VNC and egress).
NEXT_PUBLIC_WORKER_WS_URL=ws://localhost:4001

# Pages: the service that shows teammates' HTML pages, on an origin of its own (a different host
# from the app, so a page never runs with your session). The web app signs links with PAGES_SECRET,
# the same value on both (openssl rand -base64 32). The pages service frames only APP_URL.
PAGES_URL=http://127.0.0.1:3400
PAGES_SECRET=dev-pages-secret-change-me-0123456789

BOTD_URL=http://127.0.0.1:7070
BOTD_TOKEN=dev-botd-token-change-me

# Encrypts the stored OpenAI API key. 32 bytes, base64 (openssl rand -base64 32). Shared by the web app and the worker.
ENCRYPTION_KEY=ZGV2LWVuY3J5cHRpb24ta2V5LTMyLWJ5dGVzLWxvbmc=

# Optional memory AI. Empty URLs keep memory fully functional with keyword search and explicit saves.
# Full compatible /embeddings and /chat/completions URLs; local endpoints are supported.
# Configuring extraction opts into sending the current user message to that endpoint.
MEMORY_EMBEDDING_URL=
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_DIMENSIONS=768
# Initial cosine-distance cutoff; calibrate against your embedding model.
MEMORY_SEMANTIC_MAX_DISTANCE=0.4
MEMORY_EXTRACTION_URL=
MEMORY_EXTRACTION_MODEL=
# Optional bearer token, used only for the two memory endpoints (never the ChatGPT login).
MEMORY_AI_API_KEY=
# Shared daily HTTP request limit, including query embeddings and retries. 0 disables memory AI.
MEMORY_AI_DAILY_REQUEST_LIMIT=100
