{
  "name": "@open-bot/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "open-bot for macOS: the app, native notifications, and browsing through your home connection.",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc -p .",
    "package": "node build.mjs && electron-builder --mac --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@open-bot/egress": "workspace:*",
    "@types/node": "^24.19.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3"
  },
  "build": {
    "appId": "dev.openbot.desktop",
    "productName": "open-bot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "protocols": [
      {
        "name": "open-bot",
        "schemes": [
          "openbot"
        ]
      }
    ]
  }
}
