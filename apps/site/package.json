{
  "name": "@open-bot/site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build && node scripts/write-headers.mjs",
    "start": "node scripts/serve.mjs out 3200",
    "media:encode": "bash scripts/encode-media.sh",
    "media:serve": "node scripts/serve.mjs .media 3201",
    "media:upload": "bash scripts/upload-media.sh",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "hls-video-element": "^1.5.12",
    "media-chrome": "^4.19.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "~6.0.3"
  }
}
