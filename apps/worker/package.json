{
  "name": "@open-bot/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/worker.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run .integration.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@open-bot/accounts": "workspace:*",
    "@open-bot/agent": "workspace:*",
    "@open-bot/api": "workspace:*",
    "@open-bot/db": "workspace:*",
    "@open-bot/egress": "workspace:*",
    "@open-bot/memory": "workspace:*",
    "@open-bot/page-kit": "workspace:*",
    "@open-bot/shared": "workspace:*",
    "cron-parser": "^5.10.2",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
