{
  "name": "@open-bot/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/worker.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run .integration.test.ts"
  },
  "dependencies": {
    "@open-bot/agent": "workspace:*",
    "@open-bot/api": "workspace:*",
    "@open-bot/db": "workspace:*",
    "@open-bot/domain": "workspace:*",
    "@open-bot/egress": "workspace:*",
    "@open-bot/integrations": "workspace:*",
    "@open-bot/memory": "workspace:*",
    "@open-bot/page-kit": "workspace:*",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "cron-parser": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "web-push": "^3.6.7",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/web-push": "^3.6.4",
    "@types/ws": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
