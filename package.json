{
  "name": "open-bot",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@open-bot/web --filter=@open-bot/worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "e2e": "playwright test",
    "db:migrate": "pnpm --filter @open-bot/db migrate",
    "db:generate": "pnpm --filter @open-bot/db generate",
    "computer:build": "docker compose build computer",
    "infra:up": "docker compose up -d --wait postgres computer",
    "test:memory": "bash scripts/test-memory.sh",
    "test:bots": "bash scripts/test-bots.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "zod": "4.6.7"
  }
}
