{
  "name": "open-bot",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@open-bot/web --filter=@open-bot/worker --filter=@open-bot/pages",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p e2e",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "e2e": "playwright test",
    "db:migrate": "pnpm --filter @open-bot/db migrate",
    "db:generate": "pnpm --filter @open-bot/db generate",
    "owner:reset-password": "node --env-file-if-exists=.env scripts/ops/owner-reset-password.mjs",
    "computer:build": "docker compose build computer",
    "infra:up": "docker compose up -d --wait postgres computer",
    "test:integration": "bash scripts/test/integration.sh",
    "test:memory": "bash scripts/test/memory.sh",
    "test:owner-reset": "bash scripts/test/owner-reset.sh",
    "test:pocket-inbox": "bash scripts/test/pocket-inbox.sh",
    "test:computer-sleep": "bash scripts/test/computer-sleep.sh",
    "test:mobile-ui": "node scripts/test/mobile-ui.mjs",
    "check:doc-paths": "node scripts/check/doc-paths.mjs",
    "check:vocabulary": "node scripts/check/vocabulary.mjs",
    "test:scripts": "node --test scripts/check/*.test.mjs",
    "verify": "pnpm lint && pnpm check:doc-paths && pnpm check:vocabulary && pnpm typecheck && pnpm test && pnpm test:scripts && pnpm test:integration",
    "verify:affected": "pnpm lint && pnpm check:doc-paths && pnpm check:vocabulary && turbo run typecheck test --affected && tsc -p e2e && pnpm test:scripts && bash scripts/test/integration.sh --affected"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@open-bot/api": "workspace:*",
    "@orpc/client": "^1.16.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-mdx": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "zod": "4.6.7"
  }
}
