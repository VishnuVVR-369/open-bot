{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    // A transit node: no package has a "transit" script, so it runs nothing. Tasks that depend
    // on it get every workspace dependency's source in their hash, so a change in a package
    // misses the cache of everything that imports it, without waiting on any build.
    "transit": {
      "dependsOn": ["^transit"]
    },
    // Workspace packages are consumed as TypeScript source, so typecheck and tests need no build.
    // The one exception is page-kit's assembled dist/lib: the tasks that read it depend on
    // @open-bot/page-kit#build in their package's turbo.json (packages/page-kit, apps/pages).
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.mjs"]
    },
    "test:integration": {
      "dependsOn": ["transit"],
      "env": ["TEST_DATABASE_URL"],
      "passThroughEnv": ["CI"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
