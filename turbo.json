{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    // Workspace packages are consumed as TypeScript source, so typecheck and tests need no build.
    // The one exception is page-kit's assembled dist/lib: the tasks that read it depend on
    // @open-bot/page-kit#build in their package's turbo.json (packages/page-kit, apps/pages).
    "typecheck": {},
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.mjs"]
    },
    "test:integration": {
      "env": ["TEST_DATABASE_URL"],
      "passThroughEnv": ["CI"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
